// EMULATOR ONLY. Not integrated with production identities or applications.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null
        && request.auth.uid in ['fixture-business', 'fixture-personal', 'fixture-backup']
        && request.auth.token.email_verified == true;
      allow write: if false;
    }
  }
}
