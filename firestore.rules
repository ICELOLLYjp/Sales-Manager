rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedUser() {
      return signedIn();
      // Existing application-wide rule preserved for now; tighten staff access separately.
    }

    // The Gmail OAuth callback and future sync use Admin SDK, which bypasses
    // client rules. No client, including a signed-in client, may access these.
    match /gmailOAuthStates/{document=**} {
      allow read, write: if false;
    }
    match /gmailOAuthConnections/{document=**} {
      allow read, write: if false;
    }
    match /gmailExpenseCandidates/{document=**} {
      allow read, write: if false;
    }

    // Firestore rules grant access if ANY matching allow returns true. The
    // exclusions below are essential; the explicit denies above alone do NOT
    // override this broad legacy rule.
    match /{topLevel}/{document=**} {
      allow read, write: if allowedUser()
        && topLevel != 'gmailOAuthStates'
        && topLevel != 'gmailOAuthConnections'
        && topLevel != 'gmailExpenseCandidates';
    }
  }
}
